pipeline {
  agent any

  environment {
    REPO_URL = 'https://github.com/maituananh/backend'
    BRANCH = 'anhkiet-branch' 
    APP_NAME = 'backend-pawn-app'
  }
  
  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        
        git branch: "${BRANCH}", url: "${REPO_URL}"
      }
    }

    stage('Build') {
      steps {
        sh 'chmod +x gradlew'
        sh './gradlew clean build -x test'
      }
    }

    stage('Test') {
      steps {
        sh './gradlew test'
      }
    }

    stage('Package') {
      steps {
        sh './gradlew bootJar'
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          // Generate timestamp
          def timestamp = sh(
            script: "date +%Y%m%d%H%M%S",
                returnStdout: true
            ).trim()

            env.IMAGE_TAG = timestamp

            sh """
            docker build -t ${DOCKERHUB_REPO}:${IMAGE_TAG} .
            """
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        script {  
          withCredentials([usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
          )]) {
            sh """
            echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
            docker push ${DOCKERHUB_REPO}:${IMAGE_TAG}
            """

            // Cleanup local images (keep 3 latest)
            sh """
            docker images ${DOCKERHUB_REPO} --format "{{.Tag}}" | sort -r | tail -n +4 | xargs -r -I {} docker rmi ${DOCKERHUB_REPO}:{}
            """
          }
        }
      }
    }

    stage('Pull Docker Image') {
      steps {
        script {
          sh """
          docker pull ${DOCKERHUB_REPO}:${IMAGE_TAG}
          """
        }
      }
    }

    stage('Deploy') {
      steps {
        script {
          sh """
          echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin

          docker stop ${APP_NAME} || true
          docker rm ${APP_NAME} || true
          docker run -d \
            --name ${APP_NAME} \
            -p 8080:8080 \
            -e SPRING_PROFILES_ACTIVE=prod \
            ${DOCKERHUB_REPO}:${IMAGE_TAG}
          """
        }
      }
    }
  }
  

  post {
    success {
      echo '✅ Build & Deploy success'
    }
    failure {
      echo '❌ Pipeline failed'
    }
  }
}