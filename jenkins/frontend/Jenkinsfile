pipeline {
  agent any

  environment {
    REPO_URL           = 'https://github.com/maituananh/pawn-service-fe'
    BRANCH             = 'main'
    APP_NAME           = 'frontend-pawn-app'
    TELEGRAM_BOT_TOKEN = credentials('TELEGRAM_BOT_TOKEN')
    TELEGRAM_CHAT_ID   = credentials('TELEGRAM_CHAT_ID')
    DOCKER_USER        = credentials('DOCKER_USER')
    DOCKER_PASS        = credentials('DOCKER_PASS')
    DOCKERHUB_REPO     = credentials('DOCKERHUB_REPO_FE')
    FE_PORT            = credentials('FE_PORT')
    API_BASE_URL       = credentials('API_BASE_URL')
  }

  triggers {
    githubPush()
  }

  tools {
    nodejs 'nodejs22.14.0'
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()

        git branch: "${BRANCH}", url: "${REPO_URL}"
      }
    }

    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }

    stage('Test') {
      steps {
        sh 'npm test'
      }
    }

    stage('Build') {
      steps {
        sh 'npm run build'
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          // Generate timestamp
          def timestamp = sh(
            script: "date +%Y%m%d%H%M%S",
                returnStdout: true
            ).trim()

            env.IMAGE_TAG = timestamp

            sh """
            docker build -t \${DOCKERHUB_REPO}:\${IMAGE_TAG} .
            """
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        script {
          sh """
            echo "\${DOCKER_PASS}" | docker login -u "\${DOCKER_USER}" --password-stdin
            docker push \${DOCKERHUB_REPO}:\${IMAGE_TAG}
            """

          // Cleanup local images (keep 3 latest)
          sh """
            docker images \${DOCKERHUB_REPO} --format "{{.Tag}}" | \\
            sort -r | tail -n +4 | xargs -r -I {} docker rmi \${DOCKERHUB_REPO}:{} || true
            """
        }
      }
    }

    stage('Pull Docker Image') {
      steps {
        script {
          sh """
          docker pull \${DOCKERHUB_REPO}:\${IMAGE_TAG}
          """
        }
      }
    }

    stage('Deploy') {
      steps {
        script {
          sh """
          echo "\${DOCKER_PASS}" | docker login -u "\${DOCKER_USER}" --password-stdin

          docker stop ${APP_NAME} || true
          docker rm ${APP_NAME} || true
          docker run -d \\
            --name ${APP_NAME} \\
            -p \${FE_PORT}:80 \\
            -e VITE_API_BASE_URL=\${API_BASE_URL} \\
            \${DOCKERHUB_REPO}:\${IMAGE_TAG}
          """
        }
      }
    }
  }

  post {
    success {
      script {
        def msg = """
          ✅ *Pipeline PASSED* 🎉
          *Job:* `${env.JOB_NAME}`
          *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
          *Branch:* `${BRANCH}`
          *Duration:* ${currentBuild.durationString}
        """.stripIndent().trim()

        msg = msg.replace('`', '\\`')

        sh """
          curl -s -X POST https://api.telegram.org/bot\${TELEGRAM_BOT_TOKEN}/sendMessage \\
            -d chat_id=\${TELEGRAM_CHAT_ID} \\
            -d parse_mode=Markdown \\
            -d text="${msg}"
        """
      }
    }

    failure {
      script {
        def msg = """
          ❌ *Pipeline FAILED*
          *Job:* `${env.JOB_NAME}`
          *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
          *Branch:* `${BRANCH}`
          *Duration:* ${currentBuild.durationString}
          *Stage Failed:* `${env.STAGE_NAME ?: 'Unknown'}`
        """.stripIndent().trim()

        msg = msg.replace('`', '\\`')

        sh """
          curl -s -X POST https://api.telegram.org/bot\${TELEGRAM_BOT_TOKEN}/sendMessage \\
            -d chat_id=\${TELEGRAM_CHAT_ID} \\
            -d parse_mode=Markdown \\
            -d text="${msg}"
        """
      }
    }

    aborted {
      script {
        def msg = """
          ⚠️ *Pipeline ABORTED*
          *Job:* `${env.JOB_NAME}`
          *Build:* [#${env.BUILD_NUMBER}](${env.BUILD_URL})
          *Branch:* `${BRANCH}`
          *Duration:* ${currentBuild.durationString}
          *Stage Failed:* `${env.STAGE_NAME ?: 'Unknown'}`
        """.stripIndent().trim()

        msg = msg.replace('`', '\\`')

        sh """
          curl -s -X POST https://api.telegram.org/bot\${TELEGRAM_BOT_TOKEN}/sendMessage \\
            -d chat_id=\${TELEGRAM_CHAT_ID} \\
            -d parse_mode=Markdown \\
            -d text="${msg}"
        """
      }
    }
  }
}
